							{ "weight": 65, "add": { "component_groups": [ "goblin:type_normal" ] } },
							{ "weight": 25, "add": { "component_groups": [ "goblin:type_ranged" ] } },
							{ "weight": 10, "add": { "component_groups": [ "goblin:type_mace" ] } }
