			},
			"goblin:on_melee_attack": {
				"set_property": { "goblin:attacking": true }
			},
			"goblin:on_ranged_attack": {
				"sequence": [
					{ "set_property": { "goblin:attacking": true, "goblin:crossbow_phase": 1 } },
					{ "trigger": { "event": "goblin:apply_crossbow_lock" } }
				]
			},
			"goblin:on_tame_attempt": {},
			"goblin:on_tamed": {
				"sequence": [
					{ "remove": { "component_groups": [ "goblin:wild" ] } },
					{ "add": { "component_groups": [ "goblin:tamed" ] } },
					{ "set_property": { "goblin:idle_pose": 0 } }
				]
			},
			"goblin:on_sit_toggle": {
				"sequence": [
					{
						"filters": { "test": "has_property", "domain": "goblin:idle_pose", "value": 1 },
						"remove": { "component_groups": [ "goblin:sitting_state" ] },
						"set_property": { "goblin:idle_pose": 0 }
					},
					{
						"filters": {
							"none_of": [ { "test": "has_property", "domain": "goblin:idle_pose", "value": 1 } ]
						},
						"add": { "component_groups": [ "goblin:sitting_state" ] },
						"set_property": { "goblin:idle_pose": 1 }
					}
				]
			},
			"goblin:on_belly_rub": {},
			"goblin:on_hurt": {
				"sequence": [
					{
						"filters": { "test": "has_property", "domain": "goblin:idle_pose", "value": 2 },
