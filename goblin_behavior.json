				"sequence": [
					{ "remove": { "component_groups": [ "goblin:stage_1", "goblin:stage_2", "goblin:stage_3", "goblin:stage_4" ] } },
					{ "add": { "component_groups": [ "goblin:stage_1" ] } },
					{ "set_property": { "goblin:stage": 1 } }
				]
			},
			"goblin:set_stage_2": {
				"sequence": [
					{ "remove": { "component_groups": [ "goblin:stage_1", "goblin:stage_2", "goblin:stage_3", "goblin:stage_4" ] } },
					{ "add": { "component_groups": [ "goblin:stage_2" ] } },
					{ "set_property": { "goblin:stage": 2 } }
				]
			},
			"goblin:set_stage_3": {
				"sequence": [
					{ "remove": { "component_groups": [ "goblin:stage_1", "goblin:stage_2", "goblin:stage_3", "goblin:stage_4" ] } },
					{ "add": { "component_groups": [ "goblin:stage_3" ] } },
					{ "set_property": { "goblin:stage": 3 } }
				]
			},
			"goblin:set_stage_4": {
				"sequence": [
					{ "remove": { "component_groups": [ "goblin:stage_1", "goblin:stage_2", "goblin:stage_3", "goblin:stage_4" ] } },
					{ "add": { "component_groups": [ "goblin:stage_4" ] } },
					{ "set_property": { "goblin:stage": 4 } }
				]
			},
			"goblin:pop_real": {
				"sequence": [
					{ "set_property": { "goblin:locked": true, "goblin:lock_anim": 4 } },
					{ "add": { "component_groups": [ "goblin:locked_state" ] } }
